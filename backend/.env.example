# LLM serving — OpenAI-compatible endpoint (LM Studio / Ollama)
# LM Studio: http://localhost:1234/v1 · Ollama: http://localhost:11434/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-e4b
LLM_ENABLED=1
# LM Studio 서버 인증 켰으면 토큰. 끄면 빈값(헤더 생략).
LLM_API_KEY=
# 일부 제공자 전용 reasoning_effort(설정 시만 전송).
LLM_REASONING_EFFORT=
# reasoning 모델 thinking 토글 디렉티브. gemma-4는 "/think"면 추론을 reasoning_content로
# 분리 → content 깨끗·파싱가능. 미설정 시 미주입(provider-agnostic).
LLM_THINK_DIRECTIVE=
# reasoning 모델(gemma-4-e4b 등)은 thinking 후 답 → content 빈출력 방지 토큰 하한.
# max_tokens는 추론+content 합산이므로 reasoning(~900)+답을 수용할 값(예: 2048).
# 비-reasoning 모델이면 0/빈값으로 두면 됨(호출별 기본값 사용).
LLM_MAX_TOKENS=1024

# CORS — 정적 배포본이 터널 백엔드 호출 시 허용할 오리진(쉼표 구분).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://safenet.aieduflare.com,https://demo.yunseongt.com,https://edu-safenet.yunseongt.workers.dev

# ── Public data API keys (발급 필요) ──────────────────────────────

# 학교알리미 OpenAPI
SCHOOLINFO_ACCOUNT=
SCHOOLINFO_API_KEY=
# 학생·학부모 상담계획 및 실시 현황(apiType=61) 조회 기준.
# 미설정 시 직전 완료 연도(당해-1), 중학교(03), 지역 프리셋의 시도/시군구 코드로 조회합니다.
# 당해년도 공시는 미확정(값 뒤집힘·필드 누락)이므로 직전 완료 연도 권장.
SCHOOLINFO_PBAN_YR=
SCHOOLINFO_SCHUL_KND_CODE=03
# 데모 A/B 학교를 특정 학교알리미 학교코드 또는 학교명에 고정하려면 설정합니다.
# 코드·이름을 지정했는데 응답에 없으면 프리셋으로 폴백합니다(엉뚱한 학교 위장 방지).
# SIDO/SGG/KND를 함께 주면 UI 지역과 무관하게 그 학교 지역으로 조회합니다(지역 교차 데모).
SCHOOLINFO_A_SCHUL_CODE=
SCHOOLINFO_A_SCHUL_NM=
SCHOOLINFO_A_SIDO_CODE=
SCHOOLINFO_A_SGG_CODE=
SCHOOLINFO_A_SCHUL_KND_CODE=
SCHOOLINFO_B_SCHUL_CODE=
SCHOOLINFO_B_SCHUL_NM=
SCHOOLINFO_B_SIDO_CODE=
SCHOOLINFO_B_SGG_CODE=
SCHOOLINFO_B_SCHUL_KND_CODE=

# 나이스 교육정보 개방 포털
NEIS_API_KEY=
# 대시보드 대표 학교 메타(학교명·설립·소재지·학급수) 출처. 미설정 시 서울 개포중(강남) 기본.
NEIS_DASHBOARD_ATPT_CODE=B10
NEIS_DASHBOARD_SCHUL_CODE=7091421

# VWorld 공간정보 오픈플랫폼
VWORLD_API_KEY=

# data.go.kr 공통 일반 인증키 (법제처·HIRA·청소년상담복지센터 공용)
DATA_GO_KR_API_KEY=

# 법제처 국가법령정보 공유 서비스
LAW_API_KEY=
LAW_API_ENDPOINT=https://apis.data.go.kr/1170000/law

# 건강보험심사평가원_병원정보서비스
HIRA_API_KEY=
HIRA_API_ENDPOINT=https://apis.data.go.kr/B551182/hospInfoServicev2

# 여성가족부_청소년상담복지센터
TEEN_COUNSEL_API_KEY=
TEEN_COUNSEL_API_ENDPOINT=https://apis.data.go.kr/1383000/gmis/teenDscsnSrcnServiceV2
# operation 경로(서비스 Swagger 확인 후 지정, 예: getTeenDscsnSrcnList). 미설정 시 캐시 폴백.
TEEN_COUNSEL_OPERATION=
