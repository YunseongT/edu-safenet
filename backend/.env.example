# LLM serving — OpenAI-compatible endpoint (Ollama or LM Studio)
# Ollama default: http://localhost:11434/v1
# LM Studio default: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e4b-it-q4_K_M

# ── Public data API keys (발급 필요) ──────────────────────────────

# 학교알리미 OpenAPI
SCHOOLINFO_ACCOUNT=
SCHOOLINFO_API_KEY=

# 나이스 교육정보 개방 포털
NEIS_API_KEY=

# VWorld 공간정보 오픈플랫폼
VWORLD_API_KEY=

# data.go.kr 공통 일반 인증키 (법제처·HIRA·청소년상담복지센터 공용)
DATA_GO_KR_API_KEY=

# 법제처 국가법령정보 공유 서비스
LAW_API_KEY=
LAW_API_ENDPOINT=https://apis.data.go.kr/1170000/law

# 건강보험심사평가원_병원정보서비스
HIRA_API_KEY=
HIRA_API_ENDPOINT=https://apis.data.go.kr/B551182/hospInfoServicev2

# 여성가족부_청소년상담복지센터
TEEN_COUNSEL_API_KEY=
TEEN_COUNSEL_API_ENDPOINT=https://apis.data.go.kr/1383000/gmis/teenDscsnSrcnServiceV2
# operation 경로(서비스 Swagger 확인 후 지정, 예: getTeenDscsnSrcnList). 미설정 시 캐시 폴백.
TEEN_COUNSEL_OPERATION=
